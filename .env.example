# === Synology ===
SYNOLOGY_HOST=synology
SYNOLOGY_USER=admin
SYNOLOGY_PATH=/volume1/docker/k90
SYNOLOGY_SSH_PORT=2222

# === Web (LAN only) ===
# Ustaw własne hasło, minimum 12 znaków. Domyślnie HTTPS przez reverse proxy.
WEB_PASSWORD=
WEB_COOKIE_SECURE=true
# Loopback domyślnie; dla bezpośredniego LAN ustaw adres serwera.
# Przy HTTP w zaufanym LAN ustaw też WEB_COOKIE_SECURE=false.
WEB_BIND_IP=127.0.0.1
WEB_PORT=8000
TELEGRAM_ENABLED=true
# Lokalne dev.py zawsze wyłącza Telegram i synchronizację źródeł.
# K90_LOCAL_PASSWORD=k90-local-preview

# === Deployment ===

# Ścieżka do danych (domyślnie ./data)
# DATA_PATH=./data

# Obraz agenta (Synology / docker compose)
# AGENT_IMAGE=admroz/k90:latest

# === Garmin ===

GARMIN_EMAIL=twoj@email.com
GARMIN_PASSWORD=twoje_haslo
# GARMIN_END_DATE=2026-03-18

# === Libre ===

LIBRE_LINK_UP_USERNAME=twoj@email.com
LIBRE_LINK_UP_PASSWORD=twoje_haslo
LIBRE_LINK_UP_URL=https://api.libreview.io
LIBRE_LINK_UP_VERSION=4.16.0
# Ustaw false, jeśli czujnik Libre nie jest już używany
LIBRE_ENABLED=true
# LIBRE_SYNC_MAX_AGE_MINUTES=15

# === Agent ===

# Model LLM do konwersacji (LiteLLM format)
AGENT_MODEL=gpt-4o

# Model LLM do generowania patient summary
SUMMARY_MODEL=gpt-4o

# Opcjonalnie: GPT-6.1 Sol automatycznie używa Responses API.
# Można ustawić AGENT_MODEL=gpt-6.1-sol i pozostawić starszy SUMMARY_MODEL.
# Poniższe opcje dotyczą wyłącznie GPT-6.1 Sol (również z prefiksem openai/).
# Reasoning: low, medium, high, xhigh lub max; none nie jest obsługiwane.
AGENT_REASONING_EFFORT=low
AGENT_MAX_OUTPUT_TOKENS=8192
SUMMARY_REASONING_EFFORT=low
SUMMARY_MAX_OUTPUT_TOKENS=4096
# Limity Responses obejmują reasoning oraz tekst odpowiedzi.

# Ile ostatnich par wiadomości dołączać do kontekstu
HISTORY_MESSAGES=10

# Wyłącznie dokładne true/false; błędna wartość blokuje wywołanie modelu.
# false: tekst do modelu może wyjść bez automatycznego maskowania identyfikatorów
# i blokowania oczywistych sekretów regexami (agent, summary, historia, narzędzia).
# Jawne K90_PRIVACY_REDACT_TERMS, local-only i limity strukturalne nadal działają.
# Hindsight zachowuje niezależny filtr bazowy; zgoda na obrazy jest osobna.
K90_TEXT_FILTER_ENABLED=true

# Opcjonalne beztreściowe pomiary etapów; tylko dokładne true/false.
K90_PROFILING_ENABLED=false

# Po ilu dniach auto-odświeżenie patient summary przy starcie
SUMMARY_MAX_AGE_DAYS=7

# Maksymalna liczba tokenów output dla patient summary przez Chat Completions
SUMMARY_MAX_TOKENS=600

# Klucze API
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Ścieżka do bazy SQLite (opcjonalne, domyślnie /data/k90.db w kontenerze)
# DB_PATH=/data/k90.db

# Strefa czasowa aplikacji
APP_TIMEZONE=Europe/Warsaw

# Telegram — token z @BotFather i numeryczny identyfikator właściciela bota
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
TELEGRAM_ALLOWED_USER_ID=123456789
# Stały klucz historii rozmowy; nie zależy od komunikatora ani Telegram ID
CONVERSATION_USER_ID=owner
# TELEGRAM_POLL_TIMEOUT=30
